# Server Ports
HTTP_PORT=8087
METRICS_PORT=9097

# Apache Kafka Event Streaming Broker
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=hospital.notifications
KAFKA_CONSUMER_GROUP=notification-worker-group
KAFKA_DLQ_TOPIC=hospital.notifications.dlq
KAFKA_MAX_RETRIES=3
KAFKA_MAX_WAIT_MS=1000

# WhatsApp Gateway Provider (mock, http, fonnte)
WHATSAPP_PROVIDER=mock
WHATSAPP_API_URL=https://api.fonnte.com/send
WHATSAPP_API_TOKEN=your-whatsapp-gateway-token

# Email / SMTP Provider (mock, smtp)
EMAIL_PROVIDER=mock
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@selaras.hospital.id
SMTP_FROM_NAME=RS Selaras Medika

# Worker Concurrency & Request Timeout
WORKER_CONCURRENCY=5
REQUEST_TIMEOUT_SEC=30
