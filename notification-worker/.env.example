# Server Ports
HTTP_PORT=8087
METRICS_PORT=9097

# RabbitMQ Message Broker
RABBITMQ_URL=amqp://selaras:selaras123@localhost:5672/
RABBITMQ_QUEUE=notification.send
RABBITMQ_EXCHANGE=notification.exchange
RABBITMQ_ROUTING_KEY=notification.#
RABBITMQ_DLQ=notification.send.dlq

# WhatsApp Gateway Provider (mock, http, fonnte)
WHATSAPP_PROVIDER=mock
