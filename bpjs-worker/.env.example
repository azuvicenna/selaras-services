# Server Ports
HTTP_PORT=8086
METRICS_PORT=9096

# RabbitMQ Message Broker
RABBITMQ_URL=amqp://selaras:selaras123@localhost:5672/
RABBITMQ_QUEUE=bpjs.sync
RABBITMQ_EXCHANGE=bpjs.exchange
RABBITMQ_ROUTING_KEY=bpjs.#
RABBITMQ_DLQ=bpjs.sync.dlq
RABBITMQ_PREFETCH=10
RABBITMQ_MAX_RETRIES=3

# BPJS Web Services (TrustMark / VClaim / Antrean / Aplicares)
BPJS_CONS_ID=your-bpjs-cons-id
BPJS_SECRET_KEY=your-bpjs-secret-key
BPJS_USER_KEY=your-bpjs-user-key
BPJS_VCLAIM_BASE_URL=https://apijkn-dev.bpjs-kesehatan.go.id/vclaim-rest-dev
BPJS_ANTREAN_BASE_URL=https://apijkn-dev.bpjs-kesehatan.go.id/antreanrs_dev
BPJS_APLICARES_BASE_URL=https://apijkn-dev.bpjs-kesehatan.go.id/aplicaresws
BPJS_KODE_PPK=0115R001
REQUEST_TIMEOUT_SEC=30

# Downstream gRPC Services
EMR_SERVICE_ADDR=localhost:50052
BED_SERVICE_ADDR=localhost:50054

# Worker Concurrency
WORKER_CONCURRENCY=5
